# Blinkit App IDs
BLINKIT_PLAY_STORE_ID=com.grofers.customerapp
BLINKIT_APP_STORE_ID=1001550974

# Database Config
DATABASE_URL=postgresql://blinkit_user:blinkit_password@localhost:5432/blinkit_discovery
REDIS_URL=redis://localhost:6379/0

# API Keys
# Get your Gemini API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
# Get your Groq API key from https://console.groq.com/keys
# Primary LLM for Part 1 extraction/clustering/validation + Part 4 agent (Gemini free tier caps at 20 req/day)
GROQ_API_KEY=your_groq_api_key_here


